# Same Supabase project the live Prototype/index.html app talks to.
# Anon key is safe client-side by design (RLS-governed), same pattern the
# prototype already uses embedded directly. Copy this file to .env.local
# and fill in real values (or leave as-is — src/lib/config.ts falls back to
# these same values if the env vars are unset, matching the prototype).
NEXT_PUBLIC_SUPABASE_URL=https://dlcaxnorkqorrkfxigfg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRsY2F4bm9ya3FvcnJrZnhpZ2ZnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0MjU2MzMsImV4cCI6MjA5NTAwMTYzM30.5H3OGOtDD6fq8OpVlBe71HhOAd_mjEh8XnAMa2ykBnc

# Public catalogue JSON endpoint. The default same-origin route is cached by
# the Vercel CDN; set this to an external immutable-artifact CDN URL later.
NEXT_PUBLIC_CATALOGUE_URL=/api/catalogue/latest.json
# Temporary migration escape hatch only. Keep false for launch so a CDN outage
# cannot turn cold clients into a full Supabase catalogue request storm.
NEXT_PUBLIC_ALLOW_CATALOGUE_SUPABASE_FALLBACK=false

# Dedicated Accounts Supabase project (Auth, profiles, lists and history).
# Get the publishable/anon key from the new project's API settings.
NEXT_PUBLIC_ACCOUNTS_SUPABASE_URL=https://mdgrivegsblocgactyjy.supabase.co
NEXT_PUBLIC_ACCOUNTS_SUPABASE_ANON_KEY=

# Server-only keys for list-price notifications. Keep these out of NEXT_PUBLIC_ variables.
ACCOUNTS_SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APNS_AUTH_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=

# Optional OAuth return URL. For the hosted web app this can usually be left
# empty; for Capacitor, use the configured HTTPS/deep-link callback.
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# Contact and incorrect-deal reports are sent server-side through Resend.
# Use a verified sender address from the Resend account; never expose the API
# key with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
CONTACT_FORM_FROM_EMAIL=
# Optional destination override. Defaults to the existing Gmail inbox until
# hello@dodgydeal.co.nz has a mailbox or forwarding address.
CONTACT_FORM_TO_EMAIL=
